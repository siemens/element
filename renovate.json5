{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "group:allNonMajor",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":maintainLockFilesMonthly"
  ],
  addLabels: ["dep-bump"],
  schedule: ["before 7am on Wednesday"],
  timezone: "Etc/UTC",
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/e2e-local.sh/"],
      matchStrings: [
        "PLAYWRIGHT_IMAGE=\"(?<packageName>mcr\\.microsoft\\.com/playwright):(?<currentValue>[^\\s]+)\""
      ],
      datasourceTemplate: "docker"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/setup-lfs/action\\.yaml$/"],
      matchStrings: [
        "GIT_LFS_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+GIT_LFS_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      packageNameTemplate: "git-lfs/git-lfs",
      datasourceTemplate: "github-release-attachments"
    }
  ],
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: ["Allow npm packages on code.siemens.com without release timestamps"],
      matchDatasources: ["npm"],
      matchRegistryUrls: ["https://code.siemens.com/**"],
      minimumReleaseAgeBehaviour: "timestamp-optional"
    },
    {
      description: ["Update Git LFS release tags and archive checksums together"],
      matchPackageNames: ["git-lfs/git-lfs"],
      groupName: "Git LFS"
    },
    {
      description: ["Keep the native federation esbuild override pinned"],
      matchFileNames: ["pnpm-workspace.yaml"],
      matchDepNames: ["@angular-architects/native-federation>esbuild"],
      enabled: false
    },
    {
      groupName: "Siemens lint dependencies",
      description: ["Update Siemens lint packages together"],
      matchSourceUrls: ["https://github.com/siemens/lint"]
    },
    {
      description: [
        "Prevent Angular related major and minor updates. Those should be manually done"
      ],
      matchPackageNames: [
        "@angular/**",
        "@angular-devkit/**",
        "@angular-eslint/**",
        "@angular-architects/**",
        "@angular-builders/**",
        "ng-packagr",
        "rxjs",
        "typescript",
        "zone.js",
        "tslib"
      ],
      matchUpdateTypes: ["major", "minor"],
      enabled: false
    },
    {
      groupName: "Angular dependencies",
      description: ["Update Angular packages"],
      matchPackageNames: [
        "@angular/**",
        "@angular-devkit/**",
        "@angular-eslint/**",
        "@angular-architects/**",
        "@angular-builders/**",
        "ng-packagr",
        "rxjs",
        "typescript",
        "zone.js",
        "tslib"
      ],
      matchUpdateTypes: ["patch"],
      enabled: true
    },
    {
      groupName: "ECharts",
      description: [
        "Update ECharts packages separately as they appeared to be less stable in the past."
      ],
      matchPackageNames: ["echarts"]
    },
    {
      groupName: "Map dependencies",
      description: [
        "Update map dependencies separately as they appeared to be less stable in the past."
      ],
      matchPackageNames: ["ol", "ol-ext", "ol-mapbox-style", "@types/geojson"]
    },
    {
      groupName: "E2E dependencies",
      description: ["Update E2E packages"],
      matchPackageNames: [
        "@playwright/**",
        "@axe-core/**",
        "axe-html-reporter",
        "mcr.microsoft.com/playwright"
      ]
    }
  ]
}
