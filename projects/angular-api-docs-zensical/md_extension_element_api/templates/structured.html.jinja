{% import 'macros.html.jinja' as api with context %}
{% macro signatures(items, shared_documentation=[]) -%}
{% for signature in items %}<section id="{{ signature.anchor }}">{{ api.type_target(signature.anchor) }}
<pre><code>{{ api.fragments(signature.label, local, false) }}</code></pre>
{% for block in signature.documentation %}{% if block not in shared_documentation %}{{ api.blocks([block], local) }}{% endif %}{% endfor %}
{% if signature.parameters %}{{ rows(signature.parameters, true, 'Parameters') }}{% endif %}
{% if signature.returns %}<p><strong>Returns: </strong>{{ api.fragments(signature.returns, local) }}</p>{% endif %}
</section>{% endfor %}
{%- endmacro %}

{% macro rows(items, show_defaults, title, anchor=none) -%}
<h4{% if anchor %} id="{{ anchor }}"{% endif %}>{{ title }}</h4>
<table><thead><tr><th>Name</th><th>Type</th>{% if show_defaults %}<th>Default</th>{% endif %}<th>Description</th></tr></thead>
<tbody>{% for row in items %}<tr id="{{ row.anchor }}">
<td>{{ api.type_target(row.anchor) }}{% if row.sourceUrl %}<a href="{{ safe_url(row.sourceUrl) }}">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}{% if row.badges %} ({{ row.badges | join(', ') }}){% endif %}</td>
<td><code>{{ api.fragments(row.type, local, false) }}</code></td>{% if show_defaults %}<td>{% if row.default is not none %}<code>{{ row.default }}</code>{% endif %}</td>{% endif %}
<td>{{ api.blocks(row.documentation, local) }}</td></tr>{% endfor %}</tbody></table>
{% for row in items %}{% if row.signatures %}<h5>{{ row.name }}</h5>{{ signatures(row.signatures, row.documentation) }}{% endif %}{% endfor %}
{%- endmacro %}

<section{% if symbol_anchor %} id="{{ symbol_anchor }}"{% endif %}>
{% if symbol_anchor %}{{ api.type_target(symbol_anchor) }}{% endif %}
{% if not member %}
{% if no_heading %}<p><strong>{% else %}<h3>{% endif %}{% if symbol.sourceUrl %}<a href="{{ safe_url(symbol.sourceUrl) }}">{{ heading }}</a>{% else %}{{ heading }}{% endif %}{% if no_heading %}</strong></p>{% else %}</h3>{% endif %}
<p><strong>Kind: </strong>{{ symbol.kind.replace('undecorated_', '').replace('_', ' ') }}</p>
{% for item in symbol.metadata %}<p><strong>{{ item.label }}: </strong><code>{{ item.value }}</code></p>{% endfor %}
{% if symbol.importStatement %}<pre><code>{{ symbol.importStatement }}</code></pre>{% endif %}
{% endif %}
{{ api.blocks(view.documentation, local) }}
{% if view.declaration %}<pre><code>{{ api.fragments(view.declaration, local, false) }}</code></pre>{% endif %}
{{ signatures(view.signatures) }}
{% for group in view.groups %}
{% if group.kind in ['members', 'methods', 'constructors'] %}
<h4{% if group.anchor is defined %} id="{{ group.anchor }}"{% endif %}>{{ group.title }}</h4>
{% for row in group.rows %}<section id="{{ row.anchor }}">{{ api.type_target(row.anchor) }}<h5>{{ row.name }}</h5>
{% if row.sourceUrl %}<p><a href="{{ safe_url(row.sourceUrl) }}">Source for {{ row.name }}</a></p>{% endif %}
{% if row.badges %}<p><strong>Modifiers: </strong>{{ row.badges | join(', ') }}</p>{% endif %}
{% if not row.signatures %}<p><strong>Type: </strong><code>{{ api.fragments(row.type, local, false) }}</code></p>{% endif %}
{% if row.default is not none %}<p><strong>Default: </strong><code>{{ row.default }}</code></p>{% endif %}
{{ api.blocks(row.documentation, local) }}
{{ signatures(row.signatures, row.documentation) }}
</section>{% endfor %}
{% else %}{{ rows(group.rows, group.showDefaults, group.title, group.anchor | default(none)) }}{% endif %}
{% endfor %}
</section>
