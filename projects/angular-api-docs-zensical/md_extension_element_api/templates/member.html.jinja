{# ApiRenderer uses this instead of symbol.html.jinja when the embed selects a
   single member (for example, WidgetComponent.heading), not the whole symbol. #}
{% import 'macros.html.jinja' as api with context %}
<section
  class="si-docs-api no-copy"
  data-api-symbol="{{ symbol.id }}"
  data-api-mode="{{ mode }}"
  data-api-source="{{ source }}"
  data-api-member="{{ member_id }}"
>
  {% for group in view.groups %}{{ api.group(group, local, mode) }}{% endfor %}
</section>
