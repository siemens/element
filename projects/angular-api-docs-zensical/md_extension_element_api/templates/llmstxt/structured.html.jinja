{# structured.py replaces browser API cards with this simpler HTML before
   Zensical converts the page to Markdown. The browser never displays it. #}
{% import 'shared/content.html.jinja' as content with context %}
{# Used for top-level functions and callable members. When a member summary
   has already printed a paragraph, don't repeat it under each overload. #}
{% macro signatures(items, shared_documentation=[]) -%}
  {% for signature in items %}
    <section id="{{ signature.anchor }}">
      {{ content.type_target(signature.anchor) }}
      <pre><code>{{ content.fragments(signature.label, local, false) }}</code></pre>
      {% for block in signature.documentation %}{% if block not in shared_documentation %}{{ content.blocks([block], local) }}{% endif %}{% endfor %}
      {% if signature.parameters %}{{ rows(signature.parameters, true, 'Parameters') }}{% endif %}
      {% if signature.returns %}
        <p><strong>Returns: </strong>{{ content.fragments(signature.returns, local) }}</p>
      {% endif %}
    </section>
  {% endfor %}
{%- endmacro %}

{# Used for bindings and parameters. Put callable details after the table so
   their code blocks and parameter tables aren't nested inside Markdown cells. #}
{% macro rows(items, show_defaults, title, anchor=none) -%}
  <h4 {% if anchor %}id="{{ anchor }}"{% endif %}>{{ title }}</h4>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        {% if show_defaults %}<th>Default</th>{% endif %}
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {% for row in items %}
        <tr id="{{ row.anchor }}">
          <td class="api-column-name">
            {{ content.type_target(row.anchor) }}{% if row.sourceUrl %}
              <a href="{{ safe_url(row.sourceUrl) }}">{{ row.name }}</a>
            {% else %}
              {{ row.name }}
            {% endif %}{% if row.badges %}({{ row.badges | join(', ') }}){% endif %}
          </td>
          <td class="api-column-type">
            <code>{{ content.fragments(row.type, local, false) }}</code>
          </td>
          {% if show_defaults %}
            <td class="api-column-default">{{ content.default_value(row, local) }}</td>
          {% endif %}
          <td class="api-column-description">{{ content.blocks(row.documentation, local) }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  {% for row in items %}{% if row.signatures %}
    <h5>{{ row.name }}</h5>
    {{ signatures(row.signatures, row.documentation) }}
  {% endif %}{% endfor %}
{%- endmacro %}

<section {% if symbol_anchor %}id="{{ symbol_anchor }}"{% endif %}>
  {% if symbol_anchor %}{{ content.type_target(symbol_anchor) }}{% endif %}
  {% if not member %}
    {% if not no_heading %}
      <h3>
        {% if symbol.sourceUrl %}
          <a href="{{ safe_url(symbol.sourceUrl) }}">{{ heading }}</a>
        {% else %}
          {{ heading }}
        {% endif %}
      </h3>
    {% endif %}
    <p><strong>Kind: </strong>{{ symbol.kind.replace('undecorated_', '').replace('_', ' ') }}</p>
    {% for item in symbol.metadata %}
      <p><strong>{{ item.label }}: </strong><code>{{ item.value }}</code></p>
    {% endfor %}
    {% if symbol.importStatement %}<pre><code>{{ symbol.importStatement }}</code></pre>{% endif %}
  {% endif %}
  {# The same main description shown by html/symbol.html.jinja, rendered here for the
   downloadable Markdown. Individual member descriptions are rendered below. #}
  {{ content.blocks(view.documentation, local) }}
  {% if view.declaration %}<pre><code>{{ content.fragments(view.declaration, local, false) }}</code></pre>{% endif %}
  {{ signatures(view.signatures) }}
  {% for group in view.groups %}
    {# Methods and other members get separate sections so details survive Markdown export. #}
    {% if group.kind in ['members', 'methods', 'constructors'] %}
      <h4 {% if group.anchor is defined %}id="{{ group.anchor }}"{% endif %}>{{ group.title }}</h4>
      {% for row in group.rows %}
        <section id="{{ row.anchor }}">
          {{ content.type_target(row.anchor) }}
          <h5>{{ row.name }}</h5>
          {% if row.sourceUrl %}
            <p><a href="{{ safe_url(row.sourceUrl) }}">Source for {{ row.name }}</a></p>
          {% endif %}
          {% if row.badges %}
            <p><strong>Modifiers: </strong>{{ row.badges | join(', ') }}</p>
          {% endif %}
          {% if not row.signatures %}
            <p>
              <strong>Type: </strong><code>{{ content.fragments(row.type, local, false) }}</code>
            </p>
          {% endif %}
          {% if row.default is not none %}
            <p><strong>Default: </strong>{{ content.default_value(row, local) }}</p>
          {% endif %}
          {{ content.blocks(row.documentation, local) }}
          {{ signatures(row.signatures, row.documentation) }}
        </section>
      {% endfor %}
    {% else %}
      {{ rows(group.rows, group.showDefaults, group.title, group.anchor | default(none)) }}
    {% endif %}
  {% endfor %}
</section>
