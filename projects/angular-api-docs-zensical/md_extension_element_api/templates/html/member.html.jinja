{# ApiRenderer uses this instead of html/symbol.html.jinja when the embed selects a
   single member (for example, WidgetComponent.heading), not the whole symbol. #}
{% import 'html/macros.html.jinja' as layout with context %}
<section
  class="si-docs-api no-copy"
  data-api-symbol="{{ symbol.id }}"
  data-api-mode="{{ mode }}"
  data-api-source="{{ source }}"
  data-api-member="{{ member_id }}"
>
  {% for group in view.groups %}{{ layout.group(group, local, mode) }}{% endfor %}
</section>
