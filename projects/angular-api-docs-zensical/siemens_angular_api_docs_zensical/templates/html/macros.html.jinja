{# Browser-only layout macros for html/symbol.html.jinja and html/member.html.jinja.
   llmstxt export uses llmstxt/structured.html.jinja instead. #}
{% import 'shared/content.html.jinja' as content with context %}
{% import 'html/markdown.md.jinja' as md %}

{# Used for doc comments on browser cards, emitting Markdown fences for SuperFences. #}
{% macro blocks(items, local) -%}
  {%- for block in items -%}
    {%- if block.kind == 'code' -%}
      {%- set code = block.parts | map(attribute='text') | join -%}
      {%- set language = block.language | default(none) -%}
      {{ md.code_fence(code, language) }}
    {%- else -%}
      <p>{{ content.fragments(block.parts, local) }}</p>
    {% endif -%}
  {%- endfor -%}
{%- endmacro %}

{# Render a row's default value without wrapping it in <code>, for use inside
   the code-first declaration overview where a parent <code> is already open. #}
{% macro _inline_default(row, local) -%}
  {%- if row.defaultLink is defined -%}
    {{ content.fragments([row.defaultLink], local, false) }}
  {%- else -%}
    {{ row.default }}
  {%- endif -%}
{%- endmacro %}

{# Code-first TypeScript declaration skeleton with clickable member anchor links. #}
{% macro code_overview(symbol, view, local) -%}
  {% set header = declaration_header(symbol, view) %}
  {% if view.signatures or header %}
    {% set total_members = view.groups | map(attribute='rows') | map('length') | sum %}
    {% set code_body -%}
      {%- if symbol.kind == 'function' and view.signatures -%}
        {%- for signature in view.signatures -%}
          {%- if not loop.first %}{{ '\n' }}{% endif -%}
          {{- 'function ' -}}
          <a class="api-code-member-link" href="{{ anchor_href(signature.anchor) }}"
            >{{ symbol.name }}</a
          >{{ content.fragments(signature_suffix(signature, symbol.name), local, false) }};
        {%- endfor -%}
      {%- elif symbol.kind in ('type_alias', 'constant') -%}
        {{ content.fragments(header, local, false) }};
      {%- elif view.groups -%}
        {{- content.fragments(header, local, false) -}}{{- ' {' -}}
        {%- for group in view.groups -%}
          {%- if not loop.first %}{{ '\n' }}{% endif -%}
          {%- if view.groups | length > 1 or group.kind in ('inputs', 'outputs') -%}
            {{ '\n  ' }}<span class="api-code-comment">// {{ overview_group_comment(group) }}</span>
          {%- endif -%}
          {%- for row in group.rows -%}
            {%- if symbol.kind == 'enum' -%}
              {{ '\n  ' }}<a class="api-code-member-link" href="{{ anchor_href(row.anchor) }}"
                >{{ row.name }}</a
              >{%- if row.default is not none -%}{{- ' = ' -}}{{ _inline_default(row, local) }}{%- endif -%},
            {%- elif group.kind == 'inputs' -%}
              {{ '\n  ' }}<a class="api-code-member-link" href="{{ anchor_href(row.anchor) }}"
                >{{ row.name }}</a
              >{%- if 'required' in row.badges -%}
                {{- ' = input.required' -}}
                {%- if row.type -%}{{- '<' -}}{{ content.fragments(row.type, local, false) }}{{- '>' -}}{%- endif -%}
                {{- '();' -}}
              {%- else -%}
                {{- ' = input' -}}
                {%- if row.type -%}{{- '<' -}}{{ content.fragments(row.type, local, false) }}{{- '>' -}}{%- endif -%}
                {{- '(' -}}
                {%- if row.default is not none -%}{{ _inline_default(row, local) }}{%- endif -%}
                {{- ');' -}}
              {%- endif -%}
              {%- if 'deprecated' in row.badges -%}
                {{- ' ' -}}<span class="api-code-comment">// @deprecated</span>
              {%- endif -%}
            {%- elif group.kind == 'outputs' -%}
              {{ '\n  ' }}<a class="api-code-member-link" href="{{ anchor_href(row.anchor) }}"
                >{{ row.name }}</a
              >{{- ' = output' -}}
              {%- if row.type -%}{{- '<' -}}{{ content.fragments(row.type, local, false) }}{{- '>' -}}{%- endif -%}
              {{- '();' -}}
              {%- if 'deprecated' in row.badges -%}
                {{- ' ' -}}<span class="api-code-comment">// @deprecated</span>
              {%- endif -%}
            {%- elif row.signatures -%}
              {%- for signature in row.signatures -%}
                {{ '\n  ' }}
                {%- if 'protected' in row.badges -%}{{- 'protected ' -}}{%- endif -%}
                {%- if 'static' in row.badges -%}{{- 'static ' -}}{%- endif -%}
                <a
                  class="api-code-member-link"
                  href="{{ anchor_href(row.anchor if loop.first else signature.anchor) }}"
                  >{{ row.name }}</a
                >{%- if 'optional' in row.badges -%}?{%- endif -%}
                {{- content.fragments(signature_suffix(signature, row.name), local, false) -}};
                {%- if 'deprecated' in row.badges -%}
                  {{- ' ' -}}<span class="api-code-comment">// @deprecated</span>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {{ '\n  ' }}
              {%- if 'protected' in row.badges -%}{{- 'protected ' -}}{%- endif -%}
              {%- if 'static' in row.badges -%}{{- 'static ' -}}{%- endif -%}
              {%- if 'readonly' in row.badges -%}{{- 'readonly ' -}}{%- endif -%}
              <a class="api-code-member-link" href="{{ anchor_href(row.anchor) }}">{{ row.name }}</a
              >{%- if 'optional' in row.badges -%}?{%- endif -%}
              {%- if row.type -%}{{- ': ' -}}{{ content.fragments(row.type, local, false) }}{%- endif -%}
              {%- if row.default is not none -%}{{- ' = ' -}}{{ _inline_default(row, local) }}{%- endif -%};
              {%- set inline_notes = [] -%}
              {%- if 'required' in row.badges %}{% set _ = inline_notes.append('required') %}{% endif -%}
              {%- if 'deprecated' in row.badges %}{% set _ = inline_notes.append('@deprecated') %}{% endif -%}
              {%- if inline_notes -%}
                {{- ' ' -}}<span class="api-code-comment">// {{ inline_notes | join(', ') }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {{- '\n}' -}}
      {%- else -%}
        {{- content.fragments(header, local, false) -}}{{- ' {}' -}}
      {%- endif -%}
    {%- endset %}
    {% if total_members > 14 %}
      <details class="api-code-overview-details" open>
        <summary class="api-code-overview-summary">
          API overview ({{ total_members }} members)
        </summary>
        <pre class="api-code-overview api-code-overview-large"><code>{{- code_body -}}</code></pre>
      </details>
    {% else %}
      <pre class="api-code-overview"><code>{{- code_body -}}</code></pre>
    {% endif %}
  {% endif %}
{%- endmacro %}

{# Used below the summary of a function. Skip doc paragraphs already shown above. #}
{% macro signatures(items, local, shared_documentation=[]) -%}
  {% for signature in items %}
    <section id="{{ signature.anchor }}" class="api-member-overload">
      {{ content.type_target(signature.anchor) }}
      <pre
        class="api-signature"
      ><code>{{ content.fragments(signature.label, local, false) }}</code></pre>
      {% for block in signature.documentation %}{% if block not in shared_documentation %}{{ blocks([block], local) }}{% endif %}{% endfor %}
      {% if signature.parameters %}{{ parameter_list(signature.parameters, local) }}{% endif %}
      {% if signature.returns and (signature.returns | map(attribute='text') | join) != 'void' %}
        <p class="api-member-returns">
          <strong>Returns: </strong
          ><code>{{ content.fragments(signature.returns, local, false) }}</code>
        </p>
      {% endif %}
    </section>
  {% endfor %}
{%- endmacro %}

{# Both browser templates call this once per group, such as Inputs, Properties, or Methods.
   API views put the group heading in the page TOC; type views use an inline heading
   with the same compact linked member list below. #}
{% macro group(group, local, mode) -%}
  {% if mode == 'api' %}
    {{ '\n\n' }}{{ md.heading(4, group.title, group.anchor) }}
  {% else %}
    <div id="{{ group.anchor }}" class="api-member-group-header" role="heading" aria-level="4">
      {{ group.title }}<a
        class="headerlink"
        href="#{{ group.anchor | urlencode }}"
        title="Permanent link to {{ group.title }}"
        >¶</a
      >
    </div>
  {% endif %}
  {{ member_list(group.rows, group.title, local) }}{{ '\n\n' }}
{%- endmacro %}

{# Compact parameter list for methods, constructors, and functions. #}
{% macro parameter_list(items, local) -%}
  <div class="api-param-group" role="group" aria-label="Parameters">
    <strong class="api-param-heading">Parameters</strong>
    <ul class="api-param-list" role="list">
      {% for param in items %}
        <li id="{{ param.anchor }}" class="api-param-item">
          {{ content.type_target(param.anchor) }}<span class="api-param-signature"
            ><code class="api-param-name"
              >{% if 'rest' in param.badges %}...{% endif %}{{ param.name }}{% if 'optional' in param.badges %}?{% endif %}</code
            >{% if param.type %}
              <span class="api-member-punctuation">:</span>
              <code class="api-member-type">{{ content.fragments(param.type, local, false) }}</code>
            {% endif %}{% if param.default is not none %}
              <span class="api-member-default"
                ><span class="api-member-punctuation">=</span>
                {{ content.default_value(param, local) }}</span
              >
            {% endif %}</span
          >
          {% if param.documentation %}
            <div class="api-param-notes">{{ blocks(param.documentation, local) }}</div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{%- endmacro %}

{# Compact linked member list used consistently for all symbol kinds. #}
{% macro member_list(items, title, local) -%}
  <ul class="api-member-list" role="list" aria-label="{{ title }}">
    {% for row in items %}
      <li id="{{ row.anchor }}" class="api-member-item">
        {{- content.type_target(row.anchor) | trim -}}
        <div class="api-member-header">
          <span class="api-member-signature">
            {% if 'protected' in row.badges %}
              <span class="api-member-modifier">protected</span>
            {% endif %}{% if 'static' in row.badges %}
              <span class="api-member-modifier">static</span>
            {% endif %}{% if 'readonly' in row.badges %}
              <span class="api-member-modifier">readonly</span>
            {% endif %}<code class="api-member-name"
              >{{ row.name }}{% if 'optional' in row.badges %}?{% endif %}</code
            >{% if row.signatures %}
              <code class="api-member-type"
                >{{ content.fragments(signature_suffix(row.signatures[0], row.name), local, false) }}</code
              >
            {% elif row.type %}
              <span class="api-member-punctuation">:</span>
              <code class="api-member-type">{{ content.fragments(row.type, local, false) }}</code>
            {% endif %}{% if row.default is not none %}
              <span class="api-member-default"
                ><span class="api-member-punctuation">=</span>
                {{ content.default_value(row, local) }}</span
              >
            {% endif %}
          </span>
          <span class="api-member-meta">
            {% for badge in row.badges if badge not in ('readonly', 'optional', 'protected', 'static') %}
              <span class="api-badge" data-badge="{{ badge }}">{{ badge }}</span>
            {% endfor %}
            {% if row.sourceUrl %}
              <a
                class="api-member-source"
                href="{{ safe_url(row.sourceUrl) }}"
                title="Source for {{ row.name }}"
                >Source</a
              >
            {% endif %}
            <a
              class="headerlink"
              href="#{{ row.anchor | urlencode }}"
              title="Permanent link to {{ row.name }}"
              >¶</a
            >
          </span>
        </div>
        {% if row.documentation or row.signatures %}
          <div class="api-member-body">
            {{ blocks(row.documentation, local) }}
            {% for signature in row.signatures %}
              <section id="{{ signature.anchor }}" class="api-member-overload">
                {{ content.type_target(signature.anchor) }}
                {% if not loop.first %}
                  <p class="api-member-overload-signature">
                    <code>{{ content.fragments(signature.label, local, false) }}</code>
                  </p>
                {% endif %}
                {% for block in signature.documentation %}{% if block not in row.documentation %}{{ blocks([block], local) }}{% endif %}{% endfor %}
                {% if signature.parameters %}{{ parameter_list(signature.parameters, local) }}{% endif %}
                {% if signature.returns and row.name != 'constructor' and (signature.returns | map(attribute='text') | join) != 'void' %}
                  <p class="api-member-returns">
                    <strong>Returns: </strong
                    ><code>{{ content.fragments(signature.returns, local, false) }}</code>
                  </p>
                {% endif %}
              </section>
            {% endfor %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{%- endmacro %}
