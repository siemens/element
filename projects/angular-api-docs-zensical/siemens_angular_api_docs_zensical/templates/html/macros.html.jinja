{# Browser-only layout macros for html/symbol.html.jinja and html/member.html.jinja.
   llmstxt export uses llmstxt/structured.html.jinja instead. #}
{% import 'shared/content.html.jinja' as content with context %}
{% import 'html/markdown.md.jinja' as md %}

{# Used for doc comments on browser cards, emitting Markdown fences for SuperFences. #}
{% macro blocks(items, local) -%}
  {%- for block in items -%}
    {%- if block.kind == 'code' -%}
      {%- set code = block.parts | map(attribute='text') | join -%}
      {%- set language = block.language | default(none) -%}
      {{ md.code_fence(code, language) }}
    {%- else -%}
      <p>{{ content.fragments(block.parts, local) }}</p>
    {% endif -%}
  {%- endfor -%}
{%- endmacro %}

{# Render a TypeScript declaration header with subtle keyword spans and clickable type links. #}
{% macro _declaration_header(parts, local, symbol_kind=none) -%}
  {%- for is_kw, part in declaration_tokens(parts, symbol_kind) -%}
    {%- if is_kw -%}
      <span class="api-kw">{{ part.text }}</span>
    {%- else -%}
      {{ content.fragments([part], local, false) }}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro %}

{# Render a single indented member line inside a class or interface declaration code block. #}
{% macro _member_declaration_line(group_kind, row, local) -%}
  {{- '  ' -}}
  {%- if group_kind == 'inputs' -%}
    <a class="api-decl-member" href="#{{ row.anchor | urlencode }}">{{ row.name }}</a>
    {{- ' = ' -}}
    {%- if 'required' in row.badges -%}
      {{- 'input.required' -}}
      {%- if row.type -%}
        &lt;{{- content.fragments(row.type, local, false) -}}&gt;
      {%- endif -%}
      {{- '();' -}}
    {%- else -%}
      {{- 'input' -}}
      {%- if row.type -%}
        &lt;{{- content.fragments(row.type, local, false) -}}&gt;
      {%- endif -%}
      {{- '(' -}}
      {%- if row.default is not none -%}
        {%- if row.defaultLink is defined -%}
          {{- content.fragments([row.defaultLink], local, false) -}}
        {%- else -%}
          {{- row.default -}}
        {%- endif -%}
      {%- endif -%}
      {{- ');' -}}
    {%- endif -%}
  {%- elif group_kind == 'outputs' -%}
    <a class="api-decl-member" href="#{{ row.anchor | urlencode }}">{{ row.name }}</a>
    {{- ' = output' -}}
    {%- if row.type -%}
      &lt;{{- content.fragments(row.type, local, false) -}}&gt;
    {%- endif -%}
    {{- '();' -}}
  {%- elif (group_kind == 'constructors' or row.name == 'constructor') and row.signatures -%}
    <a class="api-decl-member" href="#{{ row.anchor | urlencode }}"
      ><span class="api-kw">constructor</span></a
    >
    {{- content.fragments(constructor_declaration(row.signatures[0]), local, false) -}};
  {%- else -%}
    {%- if 'static' in row.badges -%}
      <span class="api-kw">static</span>{{- ' ' -}}
    {%- endif -%}
    {%- if 'readonly' in row.badges -%}
      <span class="api-kw">readonly</span>{{- ' ' -}}
    {%- endif -%}
    <a class="api-decl-member" href="#{{ row.anchor | urlencode }}">{{ row.name }}</a>
    {%- if 'optional' in row.badges -%}?{%- endif -%}
    {%- if row.signatures -%}
      {{- content.fragments(method_declaration(row.signatures[0], row.name), local, false) -}}
    {%- elif row.type -%}
      {{- ': ' -}}{{- content.fragments(row.type, local, false) -}}
    {%- endif -%};
  {%- endif -%}
{%- endmacro %}

{# Render a single indented member line inside an enum declaration code block. #}
{% macro _enum_member_line(row) -%}
  {{- '  ' -}}
  <a class="api-decl-member" href="#{{ row.anchor | urlencode }}">{{ row.name }}</a>
  {%- if row.default is not none -%}
    {{- ' = ' -}}{{ row.default }}
  {%- endif -%},
{%- endmacro %}

{# Render a unified TypeScript declaration code block for every symbol kind. #}
{% macro declaration_code(symbol, view, local) -%}
  {%- if symbol.kind == 'type_alias' and view.declaration -%}
    <pre
      class="api-declaration"
    ><code>{{ _declaration_header(view.declaration, local, symbol.kind) }};</code></pre>
  {%- elif symbol.kind == 'constant' -%}
    {%- set decl_body -%}
      <span class="api-kw">const</span>{{- ' ' -}}{{ symbol.name }}
      {%- if view.declaration -%}
        {{- ': ' -}}{{- content.fragments(view.declaration, local, false) -}}
      {%- endif -%};
    {%- endset -%}
    <pre class="api-declaration"><code>{{ decl_body }}</code></pre>
  {%- elif symbol.kind == 'function' -%}
    {%- if view.signatures -%}
      {%- set decl_body -%}
        {%- for sig in view.signatures -%}
          <span class="api-kw">function</span>{{- ' ' -}}
          {{- content.fragments(sig.label, local, false) -}};{%- if not loop.last -%}{{- '\n' -}}{%- endif -%}
        {%- endfor -%}
      {%- endset -%}
      <pre class="api-declaration"><code>{{ decl_body }}</code></pre>
    {%- elif view.declaration -%}
      <pre
        class="api-declaration"
      ><code>{{ _declaration_header(view.declaration, local, symbol.kind) }};</code></pre>
    {%- endif -%}
  {%- elif symbol.kind == 'enum' and view.declaration -%}
    {%- set all_rows = namespace(items=[]) -%}
    {%- for group in view.groups -%}
      {%- for row in group.rows -%}
        {%- set _ = all_rows.items.append(row) -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- set decl_body -%}
      {{- _declaration_header(view.declaration, local, symbol.kind) -}}{{- ' ' -}}
      {%- if all_rows.items -%}
        {{- '{\n' -}}
        {%- for row in all_rows.items -%}
          {{- _enum_member_line(row) -}}{{- '\n' -}}
        {%- endfor -%}
        {{- '}' -}}
      {%- else -%}
        {{- '{}' -}}
      {%- endif -%}
    {%- endset -%}
    <pre class="api-declaration"><code>{{ decl_body }}</code></pre>
  {%- elif (symbol.kind == 'interface' or symbol.kind in class_kinds) and view.declaration -%}
    {%- set clusters = declaration_clusters(view.groups) -%}
    {%- set show_comments = (clusters | length > 1) or (clusters | length == 1 and clusters[0].label in ('Inputs', 'Outputs')) -%}
    {%- set decl_body -%}
      {{- _declaration_header(view.declaration, local, symbol.kind) -}}{{- ' ' -}}
      {%- if clusters -%}
        {{- '{\n' -}}
        {%- for cluster in clusters -%}
          {%- if not loop.first -%}{{- '\n' -}}{%- endif -%}
          {%- if show_comments -%}
            {{- '  ' -}}<span class="api-declaration-comment">// {{ cluster.label }}</span
            >{{- '\n' -}}
          {%- endif -%}
          {%- for group_kind, row in cluster.members -%}
            {{- _member_declaration_line(group_kind, row, local) -}}{{- '\n' -}}
          {%- endfor -%}
        {%- endfor -%}
        {{- '}' -}}
      {%- else -%}
        {{- '{}' -}}
      {%- endif -%}
    {%- endset -%}
    <pre class="api-declaration"><code>{{ decl_body }}</code></pre>
  {%- elif view.declaration -%}
    <pre
      class="api-declaration"
    ><code>{{ _declaration_header(view.declaration, local, symbol.kind) }};</code></pre>
  {%- endif -%}
{%- endmacro %}

{# Used for top-level functions and callable members. Skip doc paragraphs
   that the member summary has already shown above the overloads. #}
{% macro signatures(items, local, shared_documentation=[], compact=false, inline_first=false) -%}
  {% for signature in items %}
    {% set unique_docs = namespace(items=[]) %}
    {% for block in signature.documentation %}
      {% if block not in shared_documentation %}
        {% set _ = unique_docs.items.append(block) %}
      {% endif %}
    {% endfor %}
    {% set show_label = not (inline_first and loop.first) %}
    {% set show_returns = not compact and signature.returns %}
    {% set has_content = show_label or unique_docs.items or signature.parameters or show_returns %}
    <section
      id="{{ signature.anchor }}"
      class="{{ 'api-signature-block' if has_content else 'api-signature-block api-signature-block--empty' }}"
    >
      {{ content.type_target(signature.anchor) }}
      {% if show_label %}
        <pre
          class="api-signature"
        ><code>{{ content.fragments(signature.label, local, false) }}</code></pre>
      {% endif %}
      {% if unique_docs.items %}
        <div class="api-member-description">{{ blocks(unique_docs.items, local) }}</div>
      {% endif %}
      {% if signature.parameters %}
        <div class="api-member-sublist" role="group" aria-label="Parameters">
          <div class="api-member-sublist-title">Parameters</div>
          {{ member_list(signature.parameters, 'Parameters', local, compact=compact, nested=true) }}
        </div>
      {% endif %}
      {% if show_returns %}
        <p class="api-member-returns">
          <strong>Returns:</strong>
          <code>{{ content.fragments(signature.returns, local, false) }}</code>
        </p>
      {% endif %}
    </section>
  {% endfor %}
{%- endmacro %}

{# Both browser templates call this once per group, such as Inputs or Methods.
   API cards put the group heading in the page TOC; type cards use a compact group header. #}
{% macro group(group, local, mode) -%}
  {% if mode == 'type' %}
    <div
      {% if group.anchor %}id="{{ group.anchor }}"{% endif %}
      class="api-member-group api-member-group--compact"
      role="group"
      aria-label="{{ group.title }}"
    >
      <div class="api-member-group-title">
        <strong>{{ group.title }}</strong>{% if group.anchor %}
          <a
            class="headerlink"
            href="#{{ group.anchor | urlencode }}"
            title="Permanent link to {{ group.title }}"
            >¶</a
          >
        {% endif %}
      </div>
      {{ member_list(group.rows, group.title, local, compact=true) }}
    </div>
  {% else %}
    {{ md.heading(4, group.title, group.anchor) }}
    {{ member_list(group.rows, group.title, local, compact=false) }}
  {% endif %}
{%- endmacro %}

{# Unified flat property/member list used for Inputs, Outputs, Models,
   Properties, Methods, Enum Members, and nested Parameters everywhere. #}
{% macro member_list(items, title, local, compact=false, nested=false) -%}
  <ul
    class="{{ (['api-member-list'] + (['api-member-list--compact'] if compact else []) + (['api-member-list--nested'] if nested else [])) | join(' ') }}"
    role="list"
    aria-label="{{ title }}"
  >
    {% for row in items %}
      {% set optional = 'optional' in row.badges %}
      {% set notes = namespace(description=[], origins=[]) %}
      {% for block in row.documentation %}
        {% if block.kind == 'paragraph' and block.parts and block.parts[0].text in ('Inherited from ', 'Implements ') %}
          {% set notes.origins = notes.origins + [block] %}
        {% else %}
          {% set notes.description = notes.description + [block] %}
        {% endif %}
      {% endfor %}
      {% set visible_badges = namespace(items=[]) %}
      {% for badge in row.badges %}
        {% if badge != 'optional' and not (badge == 'inherited' and notes.origins) %}
          {% set _ = visible_badges.items.append(badge) %}
        {% endif %}
      {% endfor %}
      {% set sig_check = namespace(has_visible=false) %}
      {% if row.signatures %}
        {% if row.signatures | length > 1 %}
          {% set sig_check.has_visible = true %}
        {% endif %}
        {% for sig in row.signatures %}
          {% if sig.parameters or (not compact and sig.returns) %}
            {% set sig_check.has_visible = true %}
          {% endif %}
          {% for block in sig.documentation %}
            {% if block not in row.documentation %}
              {% set sig_check.has_visible = true %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}
      <li
        id="{{ row.anchor }}"
        class="{{ 'api-member api-member--callable' if row.signatures else 'api-member' }}"
      >
        {{ content.type_target(row.anchor) }}
        <div class="api-member-header">
          {% if not (compact and row.name == 'constructor' and row.signatures) %}
            <span class="api-member-name">
              {% if row.sourceUrl %}
                <a
                  class="api-member-name-link"
                  href="{{ safe_url(row.sourceUrl) }}"
                  title="Source for {{ row.name }}"
                  ><code
                    >{{ row.name }}{% if optional %}
                      <span class="api-member-optional">?</span>
                    {% endif %}</code
                  ></a
                >
              {% else %}
                <code
                  >{{ row.name }}{% if optional %}
                    <span class="api-member-optional">?</span>
                  {% endif %}</code
                >
              {% endif %}
            </span>
          {% endif %}
          {% if row.signatures %}
            <span class="api-member-type">
              <code
                >{{ content.fragments(callable_type(row.signatures[0], row.name), local, false) }}</code
              >
            </span>
          {% elif row.type %}
            <span class="api-member-type">
              <code>{{ content.fragments(row.type, local, false) }}</code>
            </span>
          {% endif %}
          {% if visible_badges.items or row.default is not none %}
            <span class="api-badges">
              {% for badge in visible_badges.items %}
                <span class="api-badge" data-badge="{{ badge }}">{{ badge }}</span>
              {% endfor %}
              {% if row.default is not none %}
                <span class="api-badge api-badge--default" data-badge="default"
                  ><span class="api-badge-label">default:</span>
                  {{ content.default_value(row, local) }}</span
                >
              {% endif %}
            </span>
          {% endif %}
          {% for origin in notes.origins %}
            <span class="api-member-origin">{{ content.fragments(origin.parts, local) }}</span>
          {% endfor %}
          <a
            class="headerlink"
            href="#{{ row.anchor | urlencode }}"
            title="Permanent link to {{ row.name }}"
            >¶</a
          >
        </div>
        {% if notes.description or sig_check.has_visible %}
          <div class="api-member-body">
            {% if notes.description %}
              <div class="api-member-description">{{ blocks(notes.description, local) }}</div>
            {% endif %}
            {% if row.signatures %}
              {{ signatures(row.signatures, local, row.documentation, compact=compact, inline_first=true) }}
            {% endif %}
          </div>
        {% elif row.signatures %}
          {{ signatures(row.signatures, local, row.documentation, compact=compact, inline_first=true) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{%- endmacro %}
