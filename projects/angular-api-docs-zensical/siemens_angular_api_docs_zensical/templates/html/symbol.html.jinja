{# ApiRenderer uses this for full browser cards: api() shows the API of
   a component, directive, or other symbol. api_type() and api_types()
   show compact type cards. For the main description, see view.documentation below. #}
{% import 'shared/content.html.jinja' as content with context %}
{% import 'html/macros.html.jinja' as layout with context %}
{% import 'html/markdown.md.jinja' as md %}
{# API declarations are not standalone copyable examples. Avoid the theme
   inserting duplicate unlabeled navigation landmarks for every signature. #}
{# Search needs IDs on headings to start separate sections. Keep the target on
   the wrapper only when the embed deliberately omits its heading. #}
<section
  class="si-docs-api no-copy"
  {% if mode == 'api' %}markdown="1"{% endif %}
  {% if no_heading %}id="{{ symbol_anchor }}"{% endif %}
  data-api-symbol="{{ symbol.id }}"
  data-api-mode="{{ mode }}"
  data-api-source="{{ source }}"
  data-api-heading="{{ heading }}"
  data-api-no-heading="{{ 'true' if no_heading else 'false' }}"
  {% if mode == 'api' and hide_implicitly_public %}data-api-hide-implicitly-public="true"{% endif %}
>
  {{ content.type_target(symbol_anchor, mode == 'api') }}
  {% set card_content %}
    {% if mode == 'type' or not no_heading %}
      {% set section_title = heading ~ ' API Documentation' if heading == symbol.name else heading %}
      {% set kind_label = symbol.kind.replace('undecorated_', '').replace('_', ' ') %}
      <div
        class="{{ 'api-type-header' if mode == 'type' else 'api-symbol-header' }}"
        {% if mode == 'api' %}markdown="1"{% endif %}
      >
        {% if mode == 'api' %}
          {{ md.heading(3, section_title, symbol_anchor) }}
        {% else %}
          {% if not no_heading %}
            <h3 id="{{ symbol_anchor }}">
              {% if symbol.sourceUrl %}
                <a href="{{ safe_url(symbol.sourceUrl) }}" title="Source for {{ symbol.name }}"
                  >{{ heading }}</a
                >
              {% else %}
                {{ heading }}
              {% endif %}<a
                class="headerlink"
                href="#{{ symbol_anchor | urlencode }}"
                title="Permanent link to {{ heading }}"
                >¶</a
              >
            </h3>
          {% else %}
            <a
              class="headerlink"
              href="#{{ symbol_anchor | urlencode }}"
              title="Permanent link to {{ heading }}"
              >¶</a
            >
          {% endif %}
        {% endif %}
        <div class="api-header-meta">
          {% if symbol.kind in kind_documentation %}
            <a
              class="api-kind"
              href="{{ kind_documentation[symbol.kind] }}"
              target="_blank"
              rel="noopener noreferrer"
              >{{ kind_label }}</a
            >
          {% else %}
            <span class="api-kind">{{ kind_label }}</span>
          {% endif %}
          {% if symbol.sourceUrl %}
            <a
              class="api-member-source"
              href="{{ safe_url(symbol.sourceUrl) }}"
              aria-label="Source for {{ symbol.name }}"
              >Source</a
            >
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div
      class="{{ 'api-type-body' if mode == 'type' else 'api-symbol-body' }}"
      {% if mode == 'api' %}markdown="1"{% endif %}
    >
      {% if symbol.metadata %}
        <dl class="api-metadata">
          {% for item in symbol.metadata %}
            <dt>{{ item.label }}</dt>
            <dd><code>{{ item.value }}</code></dd>
          {% endfor %}
        </dl>
      {% endif %}
      {% if symbol.importStatement and (mode != 'type' or source.startswith('api/')) %}
        <pre class="api-import"><code>{{ symbol.importStatement }}</code></pre>
      {% endif %}
      {# The main description comes from the symbol's TypeScript doc comment. For a
   component or directive, it appears below the selector and import. To find the
   descriptions of individual inputs, outputs, or methods, follow group() below. #}
      {{ layout.blocks(view.documentation, local) }}
      {{ layout.declaration_code(symbol, view, local) }}
      {{ layout.signatures(view.signatures, local, compact=mode == 'type') }}
      {% for group in view.groups %}{{ layout.group(group, local, mode) }}{% endfor %}
    </div>
  {% endset %}
  {% if mode == 'type' %}
    <div class="api-type-card">{{ card_content }}</div>
  {% else %}
    {{ card_content }}
  {% endif %}
</section>
